{
  "title": "Mouse button5=Command+tab",
  "rules": [
    {
      "description": "Mouse button5=Command+tab",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "pointing_button": "button5",
            "modifiers": {
              "mandatory": [],
              "optional": [
                "caps_lock",
                "option"
              ]
            }
          },
          "to": [{
              "key_code": "tab",
              "modifiers": ["left_command:"]
            ,
            "set_variable": {
              "name": "left_command pressed",
              "value": 1
            }
          }],
          "to_delayed_action": {
            "to_if_invoked": [{
              "set_variable": {
                "name": "left_command pressed",
                "value": 0
              }
            }],
            "to_if_canceled": [{
              "set_variable": {
                "name": "left_command pressed",
                "value": 0
              }
            }]
          }
        }
      ]
    }
  ]
}
