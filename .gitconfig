[color]
	ui = true
[push]
	default = simple
[pull]
	rebase = true
[core]
	autocrlf = input
	excludesfile = /Users/tobias/.gitignore
[user]
	email = tobias.ericsson@neo4j.com
	name = Tobias Ericsson
[url "git@github.com:"]
	insteadOf = https://github.com/
[url "git@github.com:neo-technology/neo4j-cloud.git"]
	insteadOf = https://github.com/neo-technology/neo4j-cloud
[credential]
	helper = osxkeychain
[alias]
    lol = log --oneline --decorate
    graph = log --oneline --graph --decorate
[merge]
	tool = p4merge
[grep]
    lineNumber = true
