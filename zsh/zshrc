# uncomment to profile startup time
# zmodload zsh/zprof
# Performance optimizations
DISABLE_AUTO_UPDATE="true"
DISABLE_MAGIC_FUNCTIONS="true"
DISABLE_COMPFIX="true"

# Cache completions aggressively
autoload -Uz compinit
if [ "$(date +'%j')" != "$(stat -f '%Sm' -t '%j' ~/.zcompdump 2>/dev/null)" ]; then
    compinit
else
    compinit -C
fi

ZSH=$HOME/.oh-my-zsh

ZSH_CUSTOM=$HOME/dev/me/dotfiles/zsh/custom

ZSH_THEME=""

plugins=(
        git
        direnv
        zsh-autosuggestions
        zsh-history-substring-search
        zsh-syntax-highlighting
        kube-ps1
)

source <(fzf --zsh)
source $ZSH/oh-my-zsh.sh

# Prompt: (⎈|ctx) [user@host if SSH] (branch*) last/two/dirs ❯
KUBE_PS1_NS_ENABLE=false

_kube_ctx_short() {
  # gke_<project>_<region>_<cluster> → <region-suffix>_<cluster>
  # e.g. gke_neo4j-cloud_asia-east2_production-orch-0005 → east2_production-orch-0005
  echo "${1}" | sed 's/^[^_]*_[^_]*_[^-]*-//'
}
KUBE_PS1_CLUSTER_FUNCTION=_kube_ctx_short

ZSH_THEME_GIT_PROMPT_PREFIX=" %F{cyan}("
ZSH_THEME_GIT_PROMPT_SUFFIX=")%f"
ZSH_THEME_GIT_PROMPT_DIRTY="*"
ZSH_THEME_GIT_PROMPT_CLEAN=""

_prompt_user_host() {
  [[ -n "$SSH_CONNECTION" ]] && echo "%n@%m "
}

setopt PROMPT_SUBST
PROMPT='$(kube_ps1)$(_prompt_user_host)$(git_prompt_info) %2~ ❯ '

eval $(thefuck --alias)

